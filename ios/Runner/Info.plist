<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>StepWays</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>moteur_gr</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- P1-2 audit #327 : textes d usage des permissions (FR).
	     Sans ces cles, iOS tue l app au premier acces GPS/photos. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>StepWays utilise votre position pour vous situer sur le sentier, suivre votre progression d&#8217;étape en étape et enregistrer votre randonnée.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>L&#8217;accès à la position en arrière-plan permet de poursuivre l&#8217;enregistrement de votre randonnée écran éteint et de partager votre position en temps réel avec vos proches lorsque vous l&#8217;activez.</string>
	<key>NSCameraUsageDescription</key>
	<string>L&#8217;appareil photo permet d&#8217;ajouter des photos à votre carnet de randonnée. Les photos restent sur votre téléphone.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>L&#8217;accès à vos photos permet d&#8217;illustrer votre carnet de randonnée. Les photos restent sur votre téléphone.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>StepWays utilise le Bluetooth pour se connecter a votre ceinture cardiaque et afficher votre frequence cardiaque pendant la randonnee. Cette donnee reste sur votre telephone.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>StepWays lit (lecture seule) vos pas, frequence cardiaque, distance et calories depuis l app Sante pour afficher vos statistiques de randonnee. Ces donnees restent sur votre telephone.</string>
	<!-- ================= ADMOB / iOS (tache 595, B3) =================
	     LE DEFAUT REPARE : ce fichier ne portait AUCUN identifiant publicitaire,
	     alors que le SDK Google Mobile Ads EXIGE GADApplicationIdentifier et
	     refuse de s initialiser sans lui. Android portait au moins l App ID de
	     TEST ; iOS n avait RIEN — la publicite y etait structurellement
	     impossible, et l app aurait plante au demarrage du SDK.

	     LA VALEUR N EST PAS ECRITE ICI. Elle vient du reglage de build
	     ADMOB_APP_ID_IOS (ios/Flutter/Debug.xcconfig et Release.xcconfig), qui
	     retombe sur l App ID de TEST public de Google. Aucune cle de production
	     n entre dans ce depot. -->
	<key>GADApplicationIdentifier</key>
	<string>$(ADMOB_APP_ID_IOS)</string>
	<!-- ATT (App Tracking Transparency) : texte OBLIGATOIRE des lors que l app
	     peut demander l autorisation de suivi. Sans lui la demande est
	     impossible et la revue App Store rejette le binaire. Le texte dit ce qui
	     se passe VRAIMENT : refuser ne supprime pas la publicite du niveau
	     gratuit, cela la rend non ciblee. -->
	<key>NSUserTrackingUsageDescription</key>
	<string>StepWays vous demande cette autorisation pour vous proposer des publicites adaptees a vos centres d&#8217;interet. Si vous refusez, l&#8217;application gratuite continue d&#8217;afficher des publicites, mais elles ne sont pas ciblees.</string>
	<!-- SKAdNetwork : reseaux autorises a mesurer une installation issue d une
	     publicite, sans identifiant personnel. Liste MINIMALE ET ASSUMEE :
	     Google (AdMob), la seule regie branchee. Elle s allongera le jour ou une
	     autre regie sera reellement utilisee — pas avant : une liste copiee de
	     partout declare des partenaires qui ne traitent aucune donnee pour nous.
	     -->
	<key>SKAdNetworkItems</key>
	<array>
		<dict>
			<key>SKAdNetworkIdentifier</key>
			<string>cstr6suwn9.skadnetwork</string>
		</dict>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
