<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- P1-1 audit #327 — permissions reecrites proprement depuis les specs.
         GPS sentier + enregistrement de rando en arriere-plan + suivi temps
         reel (E2.6/E2.8/E4.11) ; notifications de suivi (Android 13+) ;
         reseau pour Firebase/tuiles OSM/meteo. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Enregistrement de la randonnee ecran eteint / app en arriere-plan.
         Declaration Play Console requise (formulaire localisation arriere-plan). -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- Service de premier plan du suivi GPS (Android 14+ exige le type dedie). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Notification persistante du suivi + rappels (Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Re-portage socle : exemption d'optimisation batterie (Doze) demandee au
         lancement du trek (cas Samsung/OEM) pour que le foreground service de
         capture GPS ne soit pas suspendu ecran eteint. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Maintien du CPU eveille pendant la capture de fond (flutter_background_service). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Frequence cardiaque via ceinture BLE (Phase 6 F6F-02). Android 12+ :
         BLUETOOTH_SCAN (neverForLocation = pas de derivation de position via
         BLE) + BLUETOOTH_CONNECT. flutter_blue_plus. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- TACHE 612 — LA FICHE MEDICALE NE MONTE PAS CHEZ GOOGLE.
         Decision de Christophe du 28/09 10:42, verbatim et en majuscules dans
         son message : « NON ON NE TROUVERAIT RIEN !!! Les donnees medicales
         RESTENT sur le tel !!! ».

         MESURE DU 28/09 : ce manifeste ne declarait AUCUNE de ces trois
         proprietes. Le defaut d Android est allowBackup="true" SANS regle, donc
         tout le repertoire de donnees de l application montait chez Google des
         que le randonneur avait la sauvegarde du telephone activee — ce qui est
         le cas par defaut.

         allowBackup RESTE A VRAI, ET C EST VOULU : Christophe refuse la
         sauvegarde de ses DONNEES MEDICALES, pas celle du reste. Ce sont les
         deux fichiers de regles qui disent ce qui est exclu, et eux seuls.

         DEUX FICHIERS PARCE QU ANDROID 12 A CHANGE DE FORMAT : dataExtractionRules
         au-dessus, fullBackupContent en dessous. Les deux portent les MEMES
         exclusions, et une invariante Dart le verifie
         (test/comportement/fiche_medicale_locale_612_test.dart) contre la source
         unique de verite lib/core/services/sauvegarde_systeme.dart. -->
    <application
        android:label="StepWays"
        android:name="${applicationName}"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/regles_sauvegarde_donnees"
        android:fullBackupContent="@xml/regles_sauvegarde_complete"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Service de suivi GPS au premier plan (plugin geolocator).
             Redeclare explicitement avec son type location : exige par
             Android 14+ pour demarrer le service pendant l enregistrement
             d une rando (P1-1 audit #327). -->
        <service
            android:name="com.baseflow.geolocator.GeolocatorLocationService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location" />
        <!-- Re-portage socle : le foreground service de capture GPS de fond
             (flutter_background_service) doit declarer son type `location` pour
             demarrer pendant l'enregistrement sur Android 14+. On MERGE l'attribut
             foregroundServiceType sur le service fourni par le plugin
             (id.flutter.flutter_background_service.BackgroundService). -->
        <service
            android:name="id.flutter.flutter_background_service.BackgroundService"
            android:foregroundServiceType="location"
            tools:node="merge" />
        <!-- E5.19b : Widget Home Screen progression trek -->
        <receiver
            android:name=".TrekWidget"
            android:exported="true"
            android:label="@string/widget_trek_default_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_trek_info" />
        </receiver>
        <!-- AdMob (google_mobile_ads E4.13) — identifiant d'application
             OBLIGATOIRE : sans lui le SDK Mobile Ads fait crasher l'app au
             demarrage.

             TACHE 595 (B3) — IL N'EST PLUS ECRIT ICI. La valeur etait figee en
             dur dans ce fichier, donc NON injectable au build : impossible de
             produire un APK de production sans modifier un fichier versionne.
             C'etait d'autant plus incoherent que les EMPLACEMENTS publicitaires
             (ad-units), eux, etaient deja proprement injectes par
             `--dart-define` (`lib/core/config/ad_config.dart`). L'App ID
             arrive desormais du build via le `manifestPlaceholder` `admobAppId`
             (voir android/app/build.gradle.kts, qui documente l'injection et
             retombe sur l'App ID de TEST public de Google). -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
