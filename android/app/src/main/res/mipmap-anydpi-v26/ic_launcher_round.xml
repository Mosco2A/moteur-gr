<?xml version="1.0" encoding="utf-8"?>
<!-- Variante ronde de l'icone adaptative. Le manifeste ne declare pas
     android:roundIcon, donc aucun lanceur ne la reclame aujourd'hui ; elle est
     neanmoins tenue IDENTIQUE a ic_launcher.xml pour qu'un lanceur qui irait la
     chercher n'affiche jamais l'ancien logo (tache 632). Si elle diverge un
     jour, recopier ic_launcher.xml, ecrit par
     `dart run flutter_launcher_icons`. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
  <background android:drawable="@color/ic_launcher_background"/>
  <foreground>
      <inset
          android:drawable="@drawable/ic_launcher_foreground"
          android:inset="0%" />
  </foreground>
</adaptive-icon>
