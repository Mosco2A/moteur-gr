rules_version = '2';

// Regles de securite Firestore — StepWays (moteur GR).
//
// P0-1 audit #327 (shards #85381-#85384) : couverture follow_sessions +
// sous-collections followers/positions + miroir public minimal.
// Modele de menace suivi temps reel (E4.10-E4.12) :
//   - follow_sessions/{id} = document MAITRE prive (porte trekkerUserId).
//     Lecture/ecriture STRICTEMENT reservees au proprietaire
//     (request.auth.uid == trekkerUserId). Le suiveur anonyme ne lit
//     JAMAIS ce document — trekkerUserId n est jamais expose.
//   - follow_sessions_public/{id} = miroir public MINIMAL
//     (shareCode / isActive / expiresAtTs uniquement) servant a resoudre
//     shareCode -> sessionId cote suiveur anonyme (FollowWebScreen).
//   - positions = lisibles par un suiveur anonyme UNIQUEMENT si la
//     session est valide (isActive == true ET expiresAtTs non depasse,
//     TTL 48h du modele), verification cote serveur via get().
//     Les regles ne sachant pas parser les dates ISO-8601 du modele
//     Dart, l expiration est portee par le champ Timestamp natif
//     expiresAtTs ecrit par FollowService.
//   - followers = ecrits/lus par le proprietaire uniquement (le flux
//     addFollower passe par l app du trekker).
// Tout le reste : deny (defaut Firestore, rendu explicite en fin de fichier).
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // Donnees sentiers — lecture publique, ecriture admin uniquement
    match /trails/{trailId} {
      allow read: if true;
      match /{subcollection}/{docId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.token.admin == true;
      }
    }

    // Donnees utilisateur — lecture/ecriture par le proprietaire
    //
    // TACHE 631 — LES DROITS SONT EN LECTURE SEULE POUR LE TELEPHONE, ET C EST
    // LA REGLE LA PLUS IMPORTANTE DE CE FICHIER.
    //
    // Decision d architecture de Christophe (29/09 13:43) : « je veux que tout
    // soit en base ... seul la copie sur le tel ». LE SERVEUR FAIT FOI pour le
    // COMPTE — solde d etapes, sentiers achetes, abonnement — et la base du
    // telephone n en est qu une copie, tenue a jour par la descente des droits
    // (`core/services/descente_des_droits.dart`).
    //
    // SI LE TELEPHONE POUVAIT ECRIRE SES PROPRES DROITS, il n y aurait plus de
    // modele economique du tout : n importe qui posant `owned: true` sur un
    // sentier, ou un solde de mille etapes, se servirait lui-meme. La regle
    // generique ci-dessous autorisait precisement cela — elle donnait
    // `read, write` sur TOUTE sous-collection de `users/{uid}`, droits compris.
    // Les trois chemins du COMPTE sont donc sortis de la regle generale et
    // passent en LECTURE SEULE, AVANT elle (dans Firestore, une regle plus
    // specifique doit etre declaree pour s appliquer ; les autorisations ne se
    // soustraient pas, on ne laisse donc PAS la regle large les recouvrir).
    //
    // QUI ECRIT, ALORS : le serveur. Cloud Functions et le SDK d administration
    // IGNORENT ces regles par construction — c est le propre d un acces
    // privilegie. Aujourd hui, tant que la caisse n est pas branchee, c est
    // l administration qui pose les droits ; demain, ce sera la confirmation
    // d achat cote serveur. Dans les deux cas, jamais le telephone.
    //
    // CE QUI N EST PAS TOUCHE : tout le reste de `users/{uid}` — les donnees que
    // le randonneur produit — garde lecture ET ecriture par son proprietaire.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // --- LE COMPTE : le telephone LIT, il n ECRIT JAMAIS ---
      match /wallet/{docId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
      match /entitlements/{trailId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
      match /subscription/{docId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      // --- LE REGISTRE DE CONSENTEMENT (tache 638) ---
      //
      // DECISION DE CHRISTOPHE DU 30/09 12:32, verbatim : « Le consentement est
      // dans nos bases, horodate, c est les donnees qui n y sont pas ».
      //
      // CE QUE CE CHEMIN PORTE : une decision par finalite — accorde ou refuse,
      // quand, sous quelle version du texte, et ce qui a provoque la demande.
      // JAMAIS la donnee protegee : pas de groupe sanguin, pas d allergie, pas
      // de traitement, pas d age ni de poids. La fiche medicale n a aucun chemin
      // de sortie (liste fermee de la tache 612) et la morphologie non plus
      // (tache 635).
      //
      // ECRITURE PAR LE PROPRIETAIRE SEUL, et c est volontairement le meme
      // regime que la progression : c est le randonneur qui consent, donc c est
      // son telephone qui en fait foi. A l inverse du COMPTE (wallet /
      // entitlements / subscription), qu il ne doit jamais pouvoir s ecrire.
      // Cette regle est DECLAREE A PART plutot que laissee a la regle generique
      // juste en dessous : ecrite noir sur blanc, elle se relit et se verifie.
      match /consents/{finalite} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // --- LA PROGRESSION ET LE SAC D UN SENTIER (tache 635) ---
      //
      // CETTE REGLE MANQUAIT, ET C EST ELLE QUI EMPECHAIT TOUTE MONTEE. La
      // regle generique ci-dessous s ecrit `users/{userId}/{subcollection}/
      // {docId}` : elle couvre EXACTEMENT deux segments, donc
      // `users/{uid}/trails/{trailId}` et rien de plus. Les documents que le
      // telephone doit ecrire vivent UN CRAN PLUS BAS —
      // `users/{uid}/trails/{trailId}/user_progress/current` et
      // `.../checklist_items/{id}` — et dans Firestore une regle ne descend
      // JAMAIS toute seule dans une sous-collection. Ces deux chemins
      // retombaient donc sur le `match /{document=**}` final, qui refuse tout.
      //
      // MESURE, PAS SUPPOSEE : c est la cause premiere du constat de
      // Christophe le 29/09 (« donnees dans la base ni utilisateur ni
      // sentier ? »). Meme branchee, la montee se serait fait refuser chaque
      // ecriture par le serveur.
      //
      // LA PORTEE RESTE ETROITE : seulement sous `trails`, seulement pour son
      // proprietaire. Le compte (wallet / entitlements / subscription) garde
      // ses regles propres au-dessus et reste en LECTURE SEULE.
      match /trails/{trailId}/{sousCollection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // --- Le reste des donnees du randonneur : inchange ---
      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Session de suivi temps reel — document maitre PRIVE (E4.11)
    match /follow_sessions/{sessionId} {
      function sessionData() {
        return get(/databases/$(database)/documents/follow_sessions/$(sessionId)).data;
      }
      function isSessionOwner() {
        return isSignedIn() && sessionData().trekkerUserId == request.auth.uid;
      }
      // Session valide = active ET non expiree (TTL 48h du modele).
      // Re-verifie COTE SERVEUR a chaque lecture de position.
      function sessionIsValid() {
        return sessionData().isActive == true
          && sessionData().expiresAtTs > request.time;
      }

      // Creation par le trekker proprietaire UNIQUEMENT, payload borne :
      // schema exact du FollowSession Dart + expiresAtTs (Timestamp regles).
      // Borne 49h = TTL modele 48h + 1h de tolerance horloge client.
      allow create: if isSignedIn()
        && request.resource.data.trekkerUserId == request.auth.uid
        && request.resource.data.keys().hasOnly(
             ['id', 'trekkerUserId', 'shareCode', 'createdAt',
              'expiresAt', 'isActive', 'expiresAtTs'])
        && request.resource.data.id == sessionId
        && request.resource.data.shareCode is string
        && request.resource.data.shareCode.size() == 6
        && request.resource.data.isActive is bool
        && request.resource.data.expiresAtTs is timestamp
        && request.resource.data.expiresAtTs > request.time
        && request.resource.data.expiresAtTs <= request.time + duration.value(49, 'h');

      // Lecture/suppression : proprietaire uniquement (jamais le suiveur).
      allow get, list: if isSignedIn()
        && resource.data.trekkerUserId == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.trekkerUserId == request.auth.uid;

      // Mise a jour : proprietaire, seul isActive peut changer
      // (cloture de session) — identite et TTL immuables.
      allow update: if isSignedIn()
        && resource.data.trekkerUserId == request.auth.uid
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['isActive']);

      // Positions GPS publiees par le trekker (FollowService.publishPosition
      // + batchs GroupSyncService — memes cles, get() cachee par requete).
      match /positions/{positionId} {
        // Ecriture : trekker proprietaire, session active non expiree.
        allow create: if isSessionOwner()
          && sessionIsValid()
          && request.resource.data.keys().hasOnly(
               ['lat', 'lng', 'timestamp', 'stageId', 'batchedAt', 'syncMode'])
          && request.resource.data.lat is number
          && request.resource.data.lng is number;
        // Lecture : suiveur ANONYME autorise si session valide
        // (shareCode resolu en sessionId via le miroir public),
        // ou proprietaire. Le document position n expose aucune identite.
        allow get, list: if sessionIsValid() || isSessionOwner();
        // Une position publiee est immuable.
        allow update, delete: if false;
      }

      // Slots suiveurs — geres par l app du trekker au strict besoin :
      // comptage (list) + creation bornee. Jamais de lecture anonyme.
      match /followers/{slotId} {
        allow get, list: if isSessionOwner();
        allow create: if isSessionOwner()
          && request.resource.data.keys().hasOnly(
               ['id', 'sessionId', 'followerName', 'isPaid', 'adSupported'])
          && request.resource.data.sessionId == sessionId;
        allow update, delete: if false;
      }
    }

    // Miroir public MINIMAL — resolution shareCode -> sessionId pour le
    // suiveur anonyme, SANS exposer trekkerUserId (P0-1 audit #327).
    match /follow_sessions_public/{sessionId} {
      function privateSession() {
        return get(/databases/$(database)/documents/follow_sessions/$(sessionId)).data;
      }

      // Lecture anonyme bornee aux sessions actives. La requete du
      // FollowWebScreen filtre isActive == true (regle list prouvable).
      // L expiration TTL est re-verifiee cote serveur a la lecture des
      // positions (sessionIsValid) : un miroir actif expire n expose que
      // shareCode + expiry, jamais une position ni une identite.
      allow get, list: if resource.data.isActive == true;

      // Ecriture par le proprietaire de la session privee correspondante
      // uniquement, payload strictement minimal (JAMAIS trekkerUserId)
      // et coherent avec la session maitre.
      allow create: if isSignedIn()
        && privateSession().trekkerUserId == request.auth.uid
        && request.resource.data.keys().hasOnly(
             ['shareCode', 'isActive', 'expiresAtTs'])
        && request.resource.data.shareCode == privateSession().shareCode
        && request.resource.data.isActive is bool
        && request.resource.data.expiresAtTs is timestamp;
      // Seul isActive peut changer (cloture) — shareCode/TTL immuables.
      allow update: if isSignedIn()
        && privateSession().trekkerUserId == request.auth.uid
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['isActive']);
      allow delete: if isSignedIn()
        && privateSession().trekkerUserId == request.auth.uid;
    }

    // Signalements terrain type Waze (Phase 6 F6C-04, audit A4 DSA).
    //
    // Modele : signalement cree par un utilisateur authentifie (UID hache
    // cote client, jamais expose en clair), MODERATION A POSTERIORI (statut
    // hebergeur DSA art. 16 — design Securite D4). Le contenu du signalement
    // est IMMUABLE apres creation : seul un moderateur peut faire bouger
    // moderationState (visible/flagged/removed). Lecture publique des reports
    // non 'removed'. Pas d'edition a priori du contenu utilisateur.
    match /trail_reports/{reportId} {
      function isModerator() {
        return isSignedIn()
          && (request.auth.token.moderator == true
              || request.auth.token.admin == true);
      }
      function validNewReport() {
        return request.resource.data.type in ['obstacle', 'eau_a_sec', 'danger']
          && request.resource.data.latitude is number
          && request.resource.data.longitude is number
          && request.resource.data.authorUidHash is string
          && request.resource.data.createdAt is timestamp
          && request.resource.data.moderationState == 'visible';
      }

      // Creation : utilisateur authentifie, payload borne + valide.
      allow create: if isSignedIn()
        && validNewReport()
        && request.resource.data.keys().hasOnly(
             ['type', 'latitude', 'longitude', 'authorUidHash',
              'createdAt', 'moderationState', 'payload']);

      // Lecture publique des signalements non retires (removed invisible).
      allow get, list: if resource.data.moderationState != 'removed';

      // Mise a jour : RESERVEE au moderateur, et SEUL moderationState bouge
      // (contenu utilisateur immuable = statut hebergeur a posteriori).
      allow update: if isModerator()
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['moderationState'])
        && request.resource.data.moderationState
             in ['visible', 'flagged', 'removed'];

      // Suppression dure : moderateur uniquement.
      allow delete: if isModerator();
    }

    // Efforts de segment — leaderboard "Roi de l etape" (Phase 7 F7A-03).
    //
    // Modele (R1 pseudonyme / R2 calcul serveur) : un effort est ecrit par un
    // utilisateur AUTHENTIFIE (UID HACHE cote client, jamais expose en clair).
    // L'effort individuel est IMMUABLE apres creation (pas de re-edition, pas
    // de triche par ecrasement). Le CLASSEMENT officiel n'est PAS calcule ici :
    // une Cloud Function (classementSegment) agrege les efforts PAR TRANCHE
    // avec K-ANONYMAT (k>=5) et publie un document de classement SANS
    // timestamp fin individuel et avec des libelles PSEUDONYMES (jamais
    // "anonyme"). Les efforts bruts ne sont pas lisibles publiquement (lecture
    // reservee a l'auteur) : seul le doc de classement agrege est public.
    match /segment_efforts/{effortId} {
      function validNewEffort() {
        return request.resource.data.segmentId is string
          && request.resource.data.authorUidHash is string
          && request.resource.data.durationSeconds is int
          && request.resource.data.durationSeconds > 0
          && request.resource.data.completedAt is timestamp;
      }

      // Creation : utilisateur authentifie, payload borne + valide.
      // L'auteur ne peut ecrire QUE son propre UID hache (anti-usurpation).
      allow create: if isSignedIn()
        && validNewEffort()
        && request.resource.data.authorUidHash == request.auth.uid
        && request.resource.data.keys().hasOnly(
             ['segmentId', 'authorUidHash', 'durationSeconds', 'completedAt']);

      // Lecture : auteur uniquement (le classement public passe par le doc
      // agrege segment_rankings, jamais par les efforts individuels).
      allow get, list: if isSignedIn()
        && resource.data.authorUidHash == request.auth.uid;

      // Effort immuable : aucune re-edition ni suppression cote client.
      allow update, delete: if false;
    }

    // Classement de segment AGREGE (publie par la Cloud Function, Phase 7
    // F7A-03). Lecture publique (cache local offline-first, R2). Ecriture
    // RESERVEE au backend (Cloud Function via Admin SDK qui bypass les rules,
    // ou claim admin) : le client ne fabrique JAMAIS un classement (R2).
    // Le document ne contient PAS de timestamp fin par individu et n'emploie
    // jamais le mot "anonyme" — entrees pseudonymes par tranche (R1).
    match /segment_rankings/{segmentId} {
      function isBackend() {
        return isSignedIn() && request.auth.token.admin == true;
      }
      allow get, list: if true;
      allow create, update, delete: if isBackend();
    }

    // Classement de defi saisonnier AGREGE (Phase 7 F7C-02, meme pattern que
    // segment_rankings : calcul serveur, k-anonymat, libelles pseudonymes).
    match /defi_rankings/{defiId} {
      function isBackendDefi() {
        return isSignedIn() && request.auth.token.admin == true;
      }
      allow get, list: if true;
      allow create, update, delete: if isBackendDefi();
    }

    // Kudos sur une activite du fil (Phase 7 F7B-02/F7B-03).
    //
    // Modele (idempotence X6) : le doc id EST hash(fromUidHash +
    // targetActivityId) (calcule cote client, KudosService.remoteDocId) : un
    // meme kudo re-pousse ecrit le MEME document -> jamais de doublon. Le kudo
    // est IMMUABLE (pas d'update). L'auteur peut RETIRER son kudo (delete).
    // fromUidHash == uid (anti-usurpation). UID hache, jamais de PII en clair.
    match /kudos/{kudoId} {
      function validNewKudo() {
        return request.resource.data.fromUidHash is string
          && request.resource.data.targetActivityId is string
          && request.resource.data.createdAt is timestamp;
      }

      // Creation : utilisateur authentifie, payload borne, fromUidHash == uid.
      allow create: if isSignedIn()
        && validNewKudo()
        && request.resource.data.fromUidHash == request.auth.uid
        && request.resource.data.keys().hasOnly(
             ['fromUidHash', 'targetActivityId', 'createdAt']);

      // Lecture publique (compteur de kudos d'une activite).
      allow get, list: if isSignedIn();

      // Kudo immuable : aucune re-edition.
      allow update: if false;

      // Retrait : l'auteur du kudo uniquement.
      allow delete: if isSignedIn()
        && resource.data.fromUidHash == request.auth.uid;
    }

    // Fil d'activite (Phase 7 F7B-03). Contenu utilisateur -> HEBERGEUR DSA
    // art. 16 (notice-and-action, moderation A POSTERIORI, design Securite D4).
    //
    // Modele : l'activite est creee par un utilisateur AUTHENTIFIE
    // (authorUidHash == uid, UID hache jamais expose en clair), moderationState
    // initial 'visible'. Le CONTENU est IMMUABLE apres creation (pas d'edition
    // a priori). SEUL moderationState peut bouger, et SEULEMENT par un
    // MODERATEUR (statut hebergeur). Lecture publique des activites non
    // 'removed'.
    match /activities/{activityId} {
      function isModerator() {
        return isSignedIn()
          && (request.auth.token.moderator == true
              || request.auth.token.admin == true);
      }
      function validNewActivity() {
        return request.resource.data.authorUidHash is string
          && request.resource.data.authorUidHash == request.auth.uid
          && request.resource.data.type is string
          && request.resource.data.createdAt is timestamp
          && request.resource.data.moderationState == 'visible';
      }

      // Creation : utilisateur authentifie, payload borne + valide.
      allow create: if isSignedIn()
        && validNewActivity()
        && request.resource.data.keys().hasOnly(
             ['authorUidHash', 'type', 'payload', 'createdAt',
              'moderationState']);

      // Lecture publique des activites non retirees (removed invisible).
      allow get, list: if resource.data.moderationState != 'removed';

      // Mise a jour : RESERVEE au moderateur, et SEUL moderationState bouge
      // (contenu utilisateur immuable = statut hebergeur a posteriori, DSA).
      allow update: if isModerator()
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['moderationState'])
        && request.resource.data.moderationState
             in ['visible', 'flagged', 'removed'];

      // Suppression dure : moderateur uniquement.
      allow delete: if isModerator();
    }

    // Waypoints communautaires type FarOut (Phase 8 F8A-03, audit A3/A4).
    //
    // Modele FarOut (R1) + HEBERGEUR DSA (R4/R5) : un waypoint communautaire
    // (eau/ravitaillement/danger/camp/connectivite/jonction) est CONTRIBUE par
    // un utilisateur AUTHENTIFIE (UID hache cote client, jamais expose en clair),
    // source='communaute', moderationState initial 'visible' (PUBLICATION
    // IMMEDIATE — surtout PAS de validation a priori facon Visorando = risque
    // editeur, A4-7). MODERATION A POSTERIORI (statut hebergeur DSA art. 16,
    // design Securite D4). Le CONTENU est IMMUABLE apres creation : SEUL
    // moderationState peut bouger, et SEULEMENT par un moderateur. Lecture
    // publique des waypoints non 'removed' (cache offline-first R3).
    match /waypoints/{waypointId} {
      function isModerator() {
        return isSignedIn()
          && (request.auth.token.moderator == true
              || request.auth.token.admin == true);
      }
      function validNewWaypoint() {
        return request.resource.data.trailId is string
          && request.resource.data.type in
               ['eau', 'ravitaillement', 'danger', 'camp',
                'connectivite', 'jonction']
          && request.resource.data.latitude is number
          && request.resource.data.longitude is number
          && request.resource.data.titre is string
          && request.resource.data.authorUidHash is string
          && request.resource.data.authorUidHash == request.auth.uid
          && request.resource.data.source == 'communaute'
          && request.resource.data.lastUpdatedAt is timestamp
          && request.resource.data.moderationState == 'visible';
      }

      // Creation : utilisateur authentifie, payload borne + valide. L'auteur
      // ne peut ecrire QUE son propre UID hache (anti-usurpation).
      allow create: if isSignedIn()
        && validNewWaypoint()
        && request.resource.data.keys().hasOnly(
             ['trailId', 'type', 'latitude', 'longitude', 'titre',
              'authorUidHash', 'source', 'lastUpdatedAt', 'moderationState']);

      // Lecture publique des waypoints non retires (removed invisible).
      allow get, list: if resource.data.moderationState != 'removed';

      // Mise a jour : RESERVEE au moderateur, et SEUL moderationState bouge
      // (contenu utilisateur immuable = statut hebergeur a posteriori, DSA).
      allow update: if isModerator()
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['moderationState'])
        && request.resource.data.moderationState
             in ['visible', 'flagged', 'removed'];

      // Suppression dure : moderateur uniquement.
      allow delete: if isModerator();
    }

    // Commentaires de condition sur un waypoint (Phase 8 F8A-03). Contenu
    // utilisateur -> HEBERGEUR DSA art. 16 (notice-and-action, moderation A
    // POSTERIORI, design Securite D4).
    //
    // Modele : commentaire de condition terrain (ex 'eau_a_sec',
    // 'eau_coule_fort', 'passage glissant') cree par un utilisateur AUTHENTIFIE
    // (authorUidHash == uid, UID hache jamais expose en clair), moderationState
    // initial 'visible'. Le CONTENU est IMMUABLE apres creation. SEUL
    // moderationState peut bouger, et SEULEMENT par un MODERATEUR. Lecture
    // publique des commentaires non 'removed'.
    match /waypoint_comments/{commentId} {
      function isModerator() {
        return isSignedIn()
          && (request.auth.token.moderator == true
              || request.auth.token.admin == true);
      }
      function validNewComment() {
        return request.resource.data.waypointId is string
          && request.resource.data.authorUidHash is string
          && request.resource.data.authorUidHash == request.auth.uid
          && request.resource.data.texte is string
          && request.resource.data.createdAt is timestamp
          && request.resource.data.moderationState == 'visible';
      }

      // Creation : utilisateur authentifie, payload borne + valide.
      // condition est OPTIONNEL (ex 'eau_a_sec') — accepte present ou absent.
      allow create: if isSignedIn()
        && validNewComment()
        && request.resource.data.keys().hasOnly(
             ['waypointId', 'authorUidHash', 'texte', 'condition',
              'createdAt', 'moderationState']);

      // Lecture publique des commentaires non retires (removed invisible).
      allow get, list: if resource.data.moderationState != 'removed';

      // Mise a jour : RESERVEE au moderateur, et SEUL moderationState bouge
      // (contenu utilisateur immuable = statut hebergeur a posteriori, DSA).
      allow update: if isModerator()
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['moderationState'])
        && request.resource.data.moderationState
             in ['visible', 'flagged', 'removed'];

      // Suppression dure : moderateur uniquement.
      allow delete: if isModerator();
    }

    // Notifications de moderation NOTICE-AND-ACTION (DSA art 16, design
    // Securite D4 / D4C). Tout utilisateur AUTHENTIFIE peut signaler un contenu
    // illicite : la notification porte les mentions de l'art 16 (motif,
    // reference du contenu, contact du notifiant, declaration de bonne foi),
    // est horodatee et nait au statut 'recue'. Le TRAITEMENT (lecture +
    // changement de statut/decision) est STRICTEMENT RESERVE au role
    // MODERATEUR (custom claim moderator, ou admin) — statut hebergeur, la
    // moderation est a posteriori. Le contact du notifiant est une donnee
    // personnelle (#85383) : jamais lisible par le public, seulement par le
    // moderateur. La notification est IMMUABLE sur ses champs de fond : seuls
    // 'status' et 'decision' peuvent evoluer (par un moderateur).
    match /reports_moderation/{reportId} {
      function isModerator() {
        return isSignedIn()
          && (request.auth.token.moderator == true
              || request.auth.token.admin == true);
      }
      function validNewReport() {
        return request.resource.data.contentType is string
          && request.resource.data.contentType in
               ['trail_reports', 'activities', 'waypoints',
                'waypoint_comments']
          && request.resource.data.contentRef is string
          && request.resource.data.motif is string
          && request.resource.data.motif.size() > 0
          && request.resource.data.notifierContact is string
          && request.resource.data.bonneFoi == true
          && request.resource.data.createdAt is timestamp
          && request.resource.data.status == 'recue';
      }

      // Creation : utilisateur authentifie, payload borne aux mentions art 16.
      allow create: if isSignedIn()
        && validNewReport()
        && request.resource.data.keys().hasOnly(
             ['contentType', 'contentRef', 'motif', 'notifierContact',
              'bonneFoi', 'createdAt', 'status']);

      // Lecture/listing : RESERVE au moderateur (le contact du notifiant est
      // une donnee perso ; aucun acces public).
      allow get, list: if isModerator();

      // Traitement : RESERVE au moderateur, et SEULS status/decision bougent
      // (les mentions art 16 du notifiant sont immuables). Le nouveau statut
      // doit rester dans le cycle de vie connu.
      allow update: if isModerator()
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['status', 'decision'])
        && request.resource.data.status
             in ['recue', 'en_traitement', 'traitee'];

      // Suppression : moderateur uniquement (purge/RGPD).
      allow delete: if isModerator();
    }

    // Expose des motifs (DSA art 17, design Securite D4 / D4C). Quand un
    // moderateur statue sur une notification, un enregistrement de MOTIVATION
    // est cree a destination de l'AUTEUR du contenu restreint : il explique la
    // raison de la restriction (champ authorUidHash = UID hache de l'auteur,
    // contentType/contentRef, decision, motif, createdAt). ECRITURE reservee au
    // backend/moderateur (le client ne fabrique JAMAIS une motivation).
    // LECTURE par l'auteur concerne (authorUidHash == uid) ou un moderateur.
    match /moderation_decisions/{decisionId} {
      function isModerator() {
        return isSignedIn()
          && (request.auth.token.moderator == true
              || request.auth.token.admin == true);
      }

      // Lecture : l'auteur du contenu restreint voit sa motivation (art 17),
      // le moderateur aussi. Personne d'autre.
      allow get, list: if isSignedIn()
        && (resource.data.authorUidHash == request.auth.uid || isModerator());

      // Ecriture/maj/suppression : backend ou moderateur uniquement (le client
      // n'auto-motive pas une decision). En prod, la Cloud Function workflow
      // (Admin SDK) ecrit ce document ; un moderateur authentifie le peut aussi.
      allow create, update, delete: if isModerator();
    }

    // Plaintes / contestations (DSA art 20 — systeme interne de traitement des
    // plaintes, design Securite D4 / D4C). Un utilisateur peut CONTESTER une
    // decision de moderation le concernant. La plainte porte une reference a la
    // decision/au contenu, un expose, l'UID hache du plaignant, un horodatage
    // et nait au statut 'ouverte'. CREATION par tout utilisateur authentifie
    // (complainantUidHash == uid, anti-usurpation). LECTURE par le plaignant ou
    // un moderateur. TRAITEMENT (statut) reserve au moderateur.
    match /moderation_complaints/{complaintId} {
      function isModerator() {
        return isSignedIn()
          && (request.auth.token.moderator == true
              || request.auth.token.admin == true);
      }
      function validNewComplaint() {
        return request.resource.data.complainantUidHash is string
          && request.resource.data.complainantUidHash == request.auth.uid
          && request.resource.data.contentType is string
          && request.resource.data.contentType in
               ['trail_reports', 'activities', 'waypoints',
                'waypoint_comments']
          && request.resource.data.contentRef is string
          && request.resource.data.expose is string
          && request.resource.data.expose.size() > 0
          && request.resource.data.createdAt is timestamp
          && request.resource.data.status == 'ouverte';
      }

      // Creation : utilisateur authentifie, payload borne, UID == auteur.
      allow create: if isSignedIn()
        && validNewComplaint()
        && request.resource.data.keys().hasOnly(
             ['complainantUidHash', 'contentType', 'contentRef', 'expose',
              'createdAt', 'status']);

      // Lecture : le plaignant suit sa plainte, le moderateur la traite.
      allow get, list: if isSignedIn()
        && (resource.data.complainantUidHash == request.auth.uid
            || isModerator());

      // Traitement : moderateur uniquement, et SEUL status bouge (l'expose du
      // plaignant est immuable).
      allow update: if isModerator()
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['status'])
        && request.resource.data.status
             in ['ouverte', 'en_examen', 'tranchee'];

      // Suppression : moderateur uniquement.
      allow delete: if isModerator();
    }

    // Retours utilisateur (tache 596, C1 — « le retour qui ne part pas »).
    //
    // POURQUOI CETTE REGLE EXISTE MAINTENANT : l'application declarait les
    // retours « envoyes » sans qu'aucun octet ne quitte le telephone, puis les
    // EFFACAIT de la file locale. Il n'y avait donc ni destinataire, ni
    // collection, ni regle. Le destinataire existe desormais
    // (`FirestoreFeedbackSink` -> `user_feedback`) ; sans la regle ci-dessous,
    // le DENY final refuserait chaque envoi et le retour resterait sur le
    // telephone — honnete, mais inutile.
    //
    // DEPOT SEUL. Un randonneur depose ; il ne relit pas, ne modifie pas et
    // n'efface pas. La lecture est reservee a l'equipe (console / Admin SDK),
    // ce qui evite d'exposer les retours des autres. Authentification exigee :
    // une porte d'ecriture ouverte a tous est une porte a spam.
    match /user_feedback/{feedbackId} {
      allow create: if isSignedIn()
        && request.resource.data.trailId is string
        && request.resource.data.type is string
        && request.resource.data.type in ['bug', 'suggestion', 'compliment']
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 4000
        && request.resource.data.createdAt is string
        && request.resource.data.keys().hasOnly(
             ['trailId', 'type', 'content', 'rating', 'createdAt',
              'receivedAt']);

      allow read, update, delete: if false;
    }

    // ========================================================================
    // LE COLLECTEUR SERVEUR (tache 624, conception 611)
    // ========================================================================
    //
    // POURQUOI CES REGLES SONT LE COEUR DU DISPOSITIF ET PAS SA PERIPHERIE.
    // #L4 : « la partition est appliquee par les REGLES DE SECURITE, pas par la
    // discipline. Une convention se viole en silence ; une regle refuse. »
    //
    // Le collecteur ecrit via l'Admin SDK, qui contourne ces regles par
    // construction. Elles ne sont donc pas la pour l'autoriser — elles sont la
    // pour REFUSER tout le monde d'autre : un telephone bogue, et aussi une
    // future version de l'application qui voudrait « juste corriger » une meteo.
    // Le telephone ne doit JAMAIS pouvoir ecrire une meteo (#V5).

    // Meteo par etape — LECTURE PUBLIQUE, ecriture refusee a tout client.
    //
    // Lecture non authentifiee : le catalogue se consulte avant toute inscription
    // (trois etats, deux gestes, #E1), donc la meteo d'un sentier qu'on envisage
    // doit se consulter aussi.
    match /meteo_etape/{documentId} {
      allow read: if true;
      allow write: if false;
    }

    // Risque incendie par etape — meme regime.
    //
    // Ce document porte DEUX blocs qui ne se fondent pas : `dangerMeteo`
    // (Meteo-France, informatif) et `acces` (Etat en Corse, contraignant, #I7).
    // Un client capable d'ecrire ici serait capable de faire disparaitre une
    // interdiction d'acces a un massif en feu. D'ou `write: if false`, sans
    // exception et sans condition d'authentification qu'on pourrait un jour
    // assouplir « juste pour un test ».
    match /risque_incendie_etape/{documentId} {
      allow read: if true;
      allow write: if false;
    }

    // La borne du catalogue — un seul document, lu par tous, ecrit par les seuls
    // producteurs serveur (#K5, #K6, #K9).
    match /catalogue_borne/{documentId} {
      allow read: if true;
      allow write: if false;
    }

    // ------------------------------------------------------------------------
    // LE BATTEMENT — LECTURE REFUSEE, ET C'EST VOULU (#H4)
    // ------------------------------------------------------------------------
    // « LE BATTEMENT N'EST JAMAIS LU PAR L'APPLICATION. Si le telephone le
    // lisait, un battement vert rassurerait sur une donnee perimee. Un collecteur
    // peut tourner parfaitement et ne collecter que des echecs. »
    //
    // Ce `read: if false` est donc une DECISION DE CONCEPTION, pas un oubli de
    // permission : il rend impossible le raccourci tentant « le serveur va bien,
    // donc la donnee est bonne ». La fraicheur est portee par la donnee
    // (`produiteLe`, le jour du bulletin), la vivacite par le battement, et les
    // deux ont des lecteurs differents. L'exploitation le lit par la console ou
    // par l'Admin SDK.
    match /collecteur_battement/{documentId} {
      allow read, write: if false;
    }

    // Le registre (validateurs de cache HTTP + empreintes de contenu) et la liste
    // enrolee : mecanique interne du serveur. Aucun client n'a de raison de les
    // lire, et un client capable d'ecrire le registre pourrait faire rejouer — ou
    // faire taire — des collectes entieres.
    match /collecteur_registre/{documentId} {
      allow read, write: if false;
    }
    match /collecteur_enrolement/{documentId} {
      allow read, write: if false;
    }

    // Tout le reste : DENY explicite (collections sans regles dediees,
    // ex. groups — feature groupe sans regles a ce jour, voir
    // ORCHESTRATION wagon 3 / dette).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
