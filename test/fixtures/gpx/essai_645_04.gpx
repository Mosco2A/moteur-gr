      <trkpt lat="41.9420" lon="9.2100"><ele>980</ele><time>2026-10-02T12:24:00Z</time></trkpt>
      <trkpt lat="41.9400" lon="9.2050"><ele>850</ele><time>2026-10-02T12:36:00Z</time></trkpt>
      <trkpt lat="41.9392" lon="9.1978"><ele>730</ele><time>2026-10-02T12:48:00Z</time></trkpt>
      <trkpt lat="41.9380" lon="9.1900"><ele>750</ele><time>2026-10-02T13:00:00Z</time></trkpt>
      <trkpt lat="41.9350" lon="9.1800"><ele>720</ele><time>2026-10-02T13:12:00Z</time></trkpt>
      <trkpt lat="41.9270" lon="9.1700"><ele>650</ele><time>2026-10-02T13:24:00Z</time></trkpt>
      <trkpt lat="41.9220" lon="9.1600"><ele>620</ele><time>2026-10-02T13:36:00Z</time></trkpt>
