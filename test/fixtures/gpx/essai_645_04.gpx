      <trkpt lat="41.9392" lon="9.1978"><ele>730</ele><time>2026-10-02T10:18:00Z</time></trkpt>
      <trkpt lat="41.9380" lon="9.1900"><ele>750</ele><time>2026-10-02T10:30:00Z</time></trkpt>
      <trkpt lat="41.9350" lon="9.1800"><ele>720</ele><time>2026-10-02T10:42:00Z</time></trkpt>
      <trkpt lat="41.9270" lon="9.1700"><ele>650</ele><time>2026-10-02T10:54:00Z</time></trkpt>
      <trkpt lat="41.9220" lon="9.1600"><ele>620</ele><time>2026-10-02T11:06:00Z</time></trkpt>
      <trkpt lat="41.9180" lon="9.1500"><ele>600</ele><time>2026-10-02T11:18:00Z</time></trkpt>
      <trkpt lat="41.9147" lon="9.1411"><ele>580</ele><time>2026-10-02T11:30:00Z</time></trkpt>
      <trkpt lat="41.9140" lon="9.1380"><ele>590</ele><time>2026-10-02T11:42:00Z</time></trkpt>
    </trkseg>
  </trk>
  <trk>
