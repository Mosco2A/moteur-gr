<?xml version="1.0" encoding="UTF-8"?>
<!-- FICHIER D'ESSAI DE LA TACHE 645-04 — IMPORT GPX REEL SUR EMULATEUR.
     Il n'est pas une donnee de l'application : il sert a rejouer a la main,
     sur l'appareil, ce que les concepts C-1 (gpx_parser) et C-3 (track_point)
     touchent. Il est donc fait pour les exercer tous les deux :
       - METADATA name + desc + author  -> GpxMetadata (C-1) ;
       - DEUX trk, dont le premier a DEUX trkseg -> multi-tracks et
         multi-segments a plat, et les distances cumulees PAR segment (C-1) ;
       - <ele> ET <time> sur chaque trkpt -> le TrackPoint du domaine trek
         (elevation + timestamp), celui que GpxImportService construit (C-3) ;
       - DEUX wpt -> la liste de waypoints de GpxParseResult (C-1).
     La trace suit le vrai Mare a Mare Centre (assets/data/mare_a_mare_centre/
     track.gpx) pour que les controles « hors zone » et « hors trace » de
     l'import passent au vert : 36 points de trace (12 + 12 + 12), soit plus
     que les 10 que GpxImportService exige. -->
<gpx version="1.1" creator="Hephaistos-645-04"
     xmlns="http://www.topografix.com/GPX/1/1"
     xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:schemaLocation="http://www.topografix.com/GPX/1/1
       http://www.topografix.com/GPX/1/1/gpx.xsd">
  <metadata>
    <name>Essai 645-04 — Mare a Mare Centre, etape 1</name>
    <desc>Trace d'essai pour l'import GPX reel : deux segments, altitudes et horodatages, deux waypoints.</desc>
    <author>
      <name>Christophe</name>
    </author>
  </metadata>
  <wpt lat="42.0156" lon="9.4039">
    <ele>5</ele>
    <name>Depart — Ghisonaccia</name>
  </wpt>
  <wpt lat="41.9140" lon="9.1380">
    <ele>590</ele>
    <name>Arrivee d'essai — Catastaghju</name>
  </wpt>
  <trk>
    <name>645-04 essai — premier trk, deux segments</name>
    <trkseg>
      <trkpt lat="42.0156" lon="9.4039"><ele>5</ele><time>2026-10-02T07:00:00Z</time></trkpt>
      <trkpt lat="42.0100" lon="9.3900"><ele>45</ele><time>2026-10-02T07:12:00Z</time></trkpt>
