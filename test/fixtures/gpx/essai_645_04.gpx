      <trkpt lat="41.9870" lon="9.3500"><ele>420</ele><time>2026-10-02T07:48:00Z</time></trkpt>
      <trkpt lat="41.9780" lon="9.3300"><ele>580</ele><time>2026-10-02T08:00:00Z</time></trkpt>
      <trkpt lat="41.9700" lon="9.3100"><ele>650</ele><time>2026-10-02T08:12:00Z</time></trkpt>
      <trkpt lat="41.9630" lon="9.2980"><ele>700</ele><time>2026-10-02T08:24:00Z</time></trkpt>
      <trkpt lat="41.9567" lon="9.2864"><ele>720</ele><time>2026-10-02T08:36:00Z</time></trkpt>
      <trkpt lat="41.9550" lon="9.2800"><ele>750</ele><time>2026-10-02T08:48:00Z</time></trkpt>
      <trkpt lat="41.9520" lon="9.2650"><ele>830</ele><time>2026-10-02T09:00:00Z</time></trkpt>
      <trkpt lat="41.9480" lon="9.2400"><ele>950</ele><time>2026-10-02T09:12:00Z</time></trkpt>
    </trkseg>
    <trkseg>
      <trkpt lat="41.9450" lon="9.2300"><ele>1020</ele><time>2026-10-02T09:30:00Z</time></trkpt>
      <trkpt lat="41.9430" lon="9.2200"><ele>1050</ele><time>2026-10-02T09:42:00Z</time></trkpt>
      <trkpt lat="41.9420" lon="9.2100"><ele>980</ele><time>2026-10-02T09:54:00Z</time></trkpt>
